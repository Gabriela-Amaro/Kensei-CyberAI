        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst parts = response.candidates?.[0]?.content?.parts || [];\nconst frase = parts\n  .map((part) => part.text || '')\n  .join('')\n  .trim();\n\nreturn [\n  {\n    json: {\n      data: new Date().toISOString(),\n      frase,\n    },\n  },\n];"
      },
