        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Gere uma frase motivacional curta em português do Brasil. Responda somente com a frase, sem aspas e sem explicação.\"\n        }\n      ]\n    }\n  ]\n}",
